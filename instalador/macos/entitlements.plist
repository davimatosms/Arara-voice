<?xml version="1.0" encoding="UTF-8"?>
<!-- Só para a assinatura com Developer ID (hardened runtime), desligada no .github/workflows/macos.yml. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- JIT da JVM -->
    <key>com.apple.security.cs.allow-jit</key><true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
    <!-- whisper-jni e JNativeHook extraem as .dylib dos jars para uma pasta temporária e as carregam -->
    <key>com.apple.security.cs.disable-library-validation</key><true/>
    <!-- microfone (o texto do pedido está no Info.plist: NSMicrophoneUsageDescription) -->
    <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
